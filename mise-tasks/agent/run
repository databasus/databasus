#!/usr/bin/env bash
#MISE description="Run the verification agent with AGENT_ID, AGENT_TOKEN and optional VERIFICATION_AGENT_DATABASUS_URL"
#MISE dir="."
set -euo pipefail

if [[ -f .env ]]; then
    set -a
    # shellcheck disable=SC1091 # the developer's local file
    source .env
    set +a
fi
: "${AGENT_ID:?AGENT_ID is required}"
: "${AGENT_TOKEN:?AGENT_TOKEN is required}"

mise run agent:build
cd backend/temp/verification-agent
exec ./databasus-verification-agent run \
    --databasus-host "${VERIFICATION_AGENT_DATABASUS_URL:-http://localhost:4005}" \
    --agent-id "$AGENT_ID" \
    --token "$AGENT_TOKEN" \
    --max-cpu 4 \
    --max-ram-mb 4096 \
    --max-disk-gb 1000 \
    --max-concurrent-jobs 2 \
    --allow-insecure-http \
    --skip-update
