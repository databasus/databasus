#!/usr/bin/env bash
#MISE hide=true
#MISE description="Print the backend packages of a CI test group"
#MISE dir="backend"
#USAGE arg "<group>" help="physical, logical, physical-api, agent-e2e or other, optionally with a -<shard>-of-<count> suffix"
# CI runs one group per runner, so the groups must cover every package exactly once. The other
# group drops only the subtrees the named groups take and e2e/upgrade, which test-upgrade runs, so
# a new package lands in it, whatever its directory. A group named
# <name>-<shard>-of-<count> runs one shard of <name>'s packages, see test-group-tests.
set -euo pipefail

group="${usage_group:?}"
group_name=$(sed -E 's/-[0-9]+-of-[0-9]+$//' <<<"$group")
case "$group_name" in
    physical) go list ./internal/modules/backups/e2e/postgresqlphysical/... ;;
    logical) go list ./internal/modules/backups/e2e/... |
        grep -Ev '/postgresqlphysical(/|$)' ;;
    physical-api) go list ./internal/modules/backups/physicalapitests/... ;;
    agent-e2e) go list ./internal/agent/e2e/... ;;
    other)
        go list ./... |
            grep -Ev '/internal/(modules/backups/(physicalapitests|e2e)(/|$)|agent/e2e(/|$))|^databasus-backend/e2e/upgrade(/|$)'
        ;;
    *) echo "unknown test group: $group (expected physical, logical, physical-api, agent-e2e or other)" >&2; exit 1 ;;
esac
