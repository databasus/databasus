#!/usr/bin/env bash
#MISE hide=true
#MISE description="Check that the generated API code matches the contract"
#MISE dir="backend"
# Each oapi-codegen config is regenerated into a temporary file and compared with the committed output,
# so the lint names every generated file that is out of date without touching the checkout.
set -euo pipefail

generation_directory=$(mktemp -d)
trap 'rm -rf "$generation_directory"' EXIT

status=0
while IFS= read -r config; do
    directory=$(dirname "$config")
    output="$directory/$(sed -n 's/^output: *//p' "$config")"
    contract=$(sed -n 's|^//go:generate go tool oapi-codegen .* \([^ ]*\.yaml\)$|\1|p' "$directory/generate.go")
    if [[ -z "$contract" || ! -f "$directory/$contract" ]]; then
        echo "$directory/generate.go names no contract in its go:generate directive" >&2
        status=1
        continue
    fi
    fresh_output="$generation_directory/api.gen.go"
    fresh_config="$generation_directory/oapi-codegen.yaml"
    sed "s|^output:.*|output: $fresh_output|" "$config" >"$fresh_config"
    go -C "$directory" tool oapi-codegen -config "$fresh_config" "$contract"
    if ! cmp -s "$fresh_output" "$output"; then
        echo "$output is out of date, run mise run generate-api" >&2
        status=1
    fi
done < <(find internal -name oapi-codegen.yaml)
exit "$status"
