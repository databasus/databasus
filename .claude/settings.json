{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "GOFLAGS": "-tags=testhelpers"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" plan",
            "statusMessage": "Reviewing the plan",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" necessity",
            "statusMessage": "Checking whether the task is needed",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" architecture",
            "statusMessage": "Checking architecture",
            "timeout": 600,
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" diff",
            "statusMessage": "Reviewing the diff",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" necessity",
            "statusMessage": "Checking whether the task is needed",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" architecture",
            "statusMessage": "Checking architecture",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" naming",
            "statusMessage": "Checking names",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" implementation",
            "statusMessage": "Full implementation review",
            "timeout": 7200,
            "type": "command"
          },
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" proposal",
            "statusMessage": "Full proposal review",
            "timeout": 7200,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" snapshot",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
