{
  "name": "databasus-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "bash lint/check.sh",
    "format": "oxfmt",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "node tooling/runBrowser.ts",
    "generate:api": "pnpm exec openapi-typescript ../backend/api/openapi.yaml -o src/shared/api/schema.gen.ts"
  },
  "dependencies": {
    "@mantine/core": "9.7.5",
    "@mantine/dates": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@mantine/notifications": "9.7.5",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "5.107.1",
    "cron-parser": "^5.10.3",
    "dayjs": "^1.11.23",
    "i18next": "^26.7.1",
    "lucide-react": "1.70.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.11",
    "react-router": "8.5.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/color-name": "2.0.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "color-name": "2.1.1",
    "eslint-plugin-i18next": "^6.1.5",
    "happy-dom": "^21.0.4",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "postcss": "8.5.32",
    "postcss-value-parser": "4.2.0",
    "steiger": "0.9.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
