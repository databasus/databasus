{
  "name": "databasus-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "openapi-typescript": "pnpm --package=openapi-typescript@7.13.0 --package=typescript@5.8.3 dlx openapi-typescript",
    "generate:api": "pnpm openapi-typescript ../backend/api/openapi.yaml -o src/shared/api/schema.gen.ts",
    "check:api": "pnpm --silent generate:api --check || { echo 'src/shared/api/schema.gen.ts is out of date, run mise run generate-api' >&2; exit 1; }",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "antd": "^5.29.3",
    "cron-parser": "^5.5.0",
    "dayjs": "^1.11.20",
    "i18next": "^26.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.14",
    "react-router": "^7.15.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint-plugin-i18next": "^6.1.5",
    "msw": "^2.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.9"
}
